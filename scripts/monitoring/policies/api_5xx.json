{
  "displayName": "Alfred: 5xx responses from api / alfredCallable",
  "documentation": {
    "subject": "[Alfred] api 5xx hataları",
    "mimeType": "text/markdown",
    "content": "5 dakikada 3 veya daha fazla 5xx yanıt (Cloud Run `request_count`, `response_code_class=5xx`). `/chat` hataları SSE içinde 200 ile döner; bu uyarı çökme, zaman aşımı, faturalandırma kapalı gibi durumları yakalar. Log: `resource.type=\"cloud_run_revision\" httpRequest.status>=500`.\n\nRunbook: docs/OPERATIONS.md (Uyarılar ve runbook)."
  },
  "userLabels": {
    "managed_by": "alfred-setup-alerts",
    "alfred_alert": "api_5xx"
  },
  "severity": "CRITICAL",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Alfred: 5xx responses from api / alfredCallable",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=one_of(\"api\",\"alfredcallable\") AND metric.labels.response_code_class=\"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.label.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "1800s"
  },
  "enabled": true
}
