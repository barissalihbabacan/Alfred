# ==============================================================================
# B.U.T.L.E.R. Alfred — root .env (local development of src/, scripts, tests)
# ==============================================================================
# Copy to .env (gitignored). This file is read by the TypeScript core in src/
# (via src/core/config), the scripts (npm run test:groq, memory:reindex, ...)
# and the integration tests. It does NOT configure production:
#
#   - Production keys live only in Secret Manager (GROQ_API_KEY, GEMINI_API_KEY,
#     CEREBRAS_API_KEY, OPENROUTER_API_KEY), bound in functions/index.js.
#   - The Functions emulator reads keys from functions/.secret.local and other
#     settings from functions/.env. Never put the API keys in functions/.env:
#     the Firebase CLI deploys that file as plain env vars and Cloud Run then
#     rejects the secret of the same name.
#   - The web app (Next.js) reads its variables from apps/web/, not from here:
#     see apps/web/.env.example.
#
# Values below are the code defaults unless noted; an empty value means
# "use the default".

# --- Chat model -----------------------------------------------------------------
# groq | ollama. AI_PROVIDER is a legacy alias of ALFRED_LLM_PROVIDER.
ALFRED_LLM_PROVIDER=groq

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=
GROQ_TIMEOUT_MS=30000
# Used only by the src/ speech-to-text adapter; production has no STT endpoint.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional local model over Tailscale (ALFRED_LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://100.64.0.53:11434
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=
OLLAMA_TIMEOUT_MS=120000

# --- Embeddings and long-term memory ----------------------------------------------
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=10000
VECTOR_STORE_TYPE=local-file
VECTOR_STORE_PATH=.data/vector_store.json
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_MIN_SCORE=0.65
MEMORY_RETRIEVAL_TIMEOUT_MS=3000

MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.70
MEMORY_EXTRACTION_MAX_MESSAGES=10
MEMORY_EXTRACTION_TIMEOUT_MS=10000
# Extraction uses production's chain: Groq (this model; empty = openai/gpt-oss-20b),
# then Gemini (GEMINI_EXTRACTION_MODEL; empty = gemini-3.1-flash-lite), then
# OLLAMA_BASE_URL / OLLAMA_MODEL.
MEMORY_EXTRACTION_MODEL=
GEMINI_EXTRACTION_MODEL=

# --- Text-to-speech (src/voice only; the web app uses the browser's voice) ---------
TTS_PROVIDER=mock
TTS_VOICE=charlie
TTS_LANGUAGE=en-GB
TTS_SPEED=0.95

# --- Firestore (Firebase Admin service account for src/ repositories) --------------
FIREBASE_PROJECT_ID=butler-alfred
FIREBASE_CLIENT_EMAIL=your-service-account@butler-alfred.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
