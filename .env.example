# ==============================================================================
# B.U.T.L.E.R. Alfred — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials, API keys, or secret files to version control.

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Active AI Provider (default: ollama; supported: ollama, groq)
ALFRED_LLM_PROVIDER=ollama
AI_PROVIDER=ollama

# Ollama Local LLM Provider Configuration (Tailscale Private Network)
OLLAMA_BASE_URL=http://100.64.0.53:11434
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=
OLLAMA_TIMEOUT_MS=120000

# Groq AI Provider Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=
GROQ_TIMEOUT_MS=30000

# Local Text-to-Speech (TTS) Configuration (Kokoro-82M)
TTS_PROVIDER=kokoro
TTS_VOICE=bm_george
TTS_LANGUAGE=en-GB
TTS_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_DTYPE=q8
TTS_DEVICE=cpu
TTS_SPEED=0.95

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=butler-alfred
FIREBASE_CLIENT_EMAIL=your-service-account@butler-alfred.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=barissalihbabacan
GITHUB_REPO=B.U.T.L.E.R.-Alfred

# Google Workspace (Gmail, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_REFRESH_TOKEN=

# Other AI Model Providers (Future / Multi-provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloud Voice Providers (Future / Multi-provider)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# External Tools & Search
SERPAPI_API_KEY=
TAVILY_API_KEY=
