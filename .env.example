# ==============================================================================
# B.A.T.L.E.R. Alfred — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials, API keys, or secret files to version control.

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=batler-alfred
FIREBASE_CLIENT_EMAIL=your-service-account@batler-alfred.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=barissalihbabacan
GITHUB_REPO=B.A.T.L.E.R.-Alfred

# Google Workspace (Gmail, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_REFRESH_TOKEN=

# AI Model Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice Layer (STT / TTS)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# External Tools & Search
SERPAPI_API_KEY=
TAVILY_API_KEY=
