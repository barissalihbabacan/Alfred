    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:groq": "tsx scripts/test-groq.ts",
    "test:ollama": "tsx scripts/test-ollama.ts",
    "memory:reindex": "tsx scripts/reindex-memories.ts",
    "dev:web": "next dev apps/web -p 3000",
    "build:web": "next build apps/web"
  },
  "keywords": [
    "ai-agent",
    "executive-assistant",
    "butler-alfred"
  ],
  "author": "Barış Babacan",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@types/ssh2": "^1.15.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.3.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "groq-sdk": "^1.6.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0"
  }
