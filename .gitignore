# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output
dist/
build/
out/
.next/
target/
crates/**/target/
# Rewritten by `next dev` and `next build` (different contents each), so not tracked.
apps/web/next-env.d.ts
*.tsbuildinfo
# Cloud Functions bundle (functions/build.js), built in CI and on predeploy
functions/lib/

# Environment and secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
.secret.local
# Per-project Cloud Functions config (functions/.env.<projectId>, loaded by
# `firebase deploy --project <projectId>`) belongs to each instance, not the
# template; functions/.env.example documents the keys.
functions/.env.*
!functions/.env.example

# Firebase credentials and cache
.firebase/
# Active project / aliases: each instance runs `firebase use <projectId>` (or
# passes --project), so no project is committed.
.firebaserc
*-debug.log
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
*.pem
*.key
service-account*.json
firebase-adminsdk*.json
credentials*.json
client_secret*.json

# Local databases and runtime data
*.sqlite
*.sqlite3
*.db
local_data/
data/local/
.data/
*.vectordb/

# Logs
logs/
*.log

# IDE metadata
.claude/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db

# Local TTS, ML models and cache
models/
.cache/
.transformers/
huggingface/
*.onnx
*.onnx_data
*.bin
*.safetensors
*.pt

# Generated audio artifacts and test outputs
audio_output/
artifacts/audio/
test_output/
*.wav
*.mp3
*.ogg
*.pcm

# Firestore backups (decrypted or not) never belong in the repository.
firestore-backup*.json
firestore-backup*.json.gpg

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
