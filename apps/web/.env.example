# ==============================================================================
# apps/web — configuration of the Next.js app
# ==============================================================================
# Copy to apps/web/.env.local (gitignored) and fill in your own Firebase
# project. Next.js reads env files from apps/web/, not from the repository
# root. Every NEXT_PUBLIC_* value is inlined into the static export at build
# time and is public; none of these are secrets.
#
# Nothing project-specific is committed in the code. Required for a deployable
# build: NEXT_PUBLIC_FIREBASE_API_KEY, _PROJECT_ID and _APP_ID (Firebase console
# -> Project settings -> Your apps -> Web app config), plus the allow-list
# below. `firebase deploy` builds with VALIDATE_FIREBASE_CONFIG=true and fails
# if they are missing or if _PROJECT_ID is not the project being deployed to.
# A plain `npm run build:web` (as CI runs it) skips that check.

# Where `npm run dev:web` proxies /api/** (dev only; the export uses the
# Hosting rewrite). Default: the Functions emulator.
#   http://127.0.0.1:5001/<your-project-id>/us-central1/api
#   https://<your-project-id>.web.app/api   (production API)
ALFRED_API_ORIGIN=

# App Check debug token used on localhost only (lib/app-check-debug.ts). Empty:
# the Firebase SDK generates one per browser and prints it in the console.
# Against the production API it must be registered in the Firebase console
# (App Check -> Manage debug tokens), otherwise every call gets 401. Never
# commit a real value.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Single allowed Google account (UX check only; the server enforces its own
# ALLOWED_UID / ALLOWED_EMAIL from functions/.env.<your-project-id>). Set at
# least one; with neither, every sign-in is refused.
NEXT_PUBLIC_ALLOWED_UID=
NEXT_PUBLIC_ALLOWED_EMAIL=

# Firebase web config and reCAPTCHA Enterprise site key (public values).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Web Push certificate key (Firebase console -> Project settings -> Cloud
# Messaging -> Web Push certificates). Needed for push notifications only.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Base for the streaming POST /chat request. Default in a production build:
# https://us-central1-<NEXT_PUBLIC_FIREBASE_PROJECT_ID>.cloudfunctions.net/api
NEXT_PUBLIC_STREAM_API_BASE=
