# ==============================================================================
# B.U.T.L.E.R. Alfred — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials, API keys, or secret files to version control.

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Active AI Provider (default: groq; supported: groq, ollama)
ALFRED_LLM_PROVIDER=groq
AI_PROVIDER=groq

# Ollama Local LLM Provider Configuration (Tailscale Private Network)
OLLAMA_BASE_URL=http://100.64.0.53:11434
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=
OLLAMA_TIMEOUT_MS=120000

# Groq AI Provider Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=
GROQ_TIMEOUT_MS=30000

# Text-to-Speech (TTS) Configuration (Optional)
TTS_PROVIDER=mock
TTS_VOICE=charlie
TTS_LANGUAGE=en-GB
TTS_SPEED=0.95

# Long-Term Memory, Embeddings & Vector Database
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=10000
VECTOR_STORE_TYPE=local-file
VECTOR_STORE_PATH=.data/vector_store.json
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_RETRIEVAL_MIN_SCORE=0.65
MEMORY_RETRIEVAL_TIMEOUT_MS=3000

# Autonomous Memory Extraction
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.70
MEMORY_EXTRACTION_MAX_MESSAGES=6
MEMORY_EXTRACTION_TIMEOUT_MS=15000
MEMORY_EXTRACTION_MODEL=

# Firebase Admin / Service Account
FIREBASE_PROJECT_ID=butler-alfred
FIREBASE_CLIENT_EMAIL=your-service-account@butler-alfred.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web App Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=butler-alfred.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=butler-alfred
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=butler-alfred.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=653487811677
NEXT_PUBLIC_FIREBASE_APP_ID=1:653487811677:web:1b53984d38a210428a31b4

# Google reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lfkr68tAAAAAKOEJoZyf11tapRzOI1LP4Er6AmL
RECAPTCHA_SITE_KEY=6Lfkr68tAAAAAKOEJoZyf11tapRzOI1LP4Er6AmL

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=barissalihbabacan
GITHUB_REPO=B.U.T.L.E.R.-Alfred

# Google Workspace (Gmail, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_REFRESH_TOKEN=

# Other AI Model Providers (Future / Multi-provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloud Voice Providers (Future / Multi-provider)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# External Tools & Search
SERPAPI_API_KEY=
TAVILY_API_KEY=
