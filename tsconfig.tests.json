{
  // Type-checks tests/ and scripts/ (and the src/ and apps/web/lib code they
  // import). vitest only strips types, so without this nothing checks them.
  // Bundler resolution + DOM because some tests import apps/web/lib, which is
  // written for Next.js (extensionless imports, browser fetch types).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // tests/unit/memory-write-planner.test.ts imports plain-JS production
    // code (functions/memory-persistence.js) and a JS legacy fixture. They are
    // loaded for their inferred types only; checkJs stays off.
    "allowJs": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
