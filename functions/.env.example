# ==============================================================================
# functions/ — non-secret runtime configuration of the `api` Cloud Function
# ==============================================================================
# Copy to functions/.env.<your-project-id> (gitignored). `firebase deploy
# --project <your-project-id>` uploads it as plain environment variables, so it
# must NEVER contain an API key or token: EVREN_API_KEY, GROQ_API_KEY,
# GEMINI_API_KEY, TAVILY_API_KEY and GOOGLE_OAUTH_CLIENT_ID/SECRET are bound
# with defineSecret() and live in Secret Manager
# (`firebase functions:secrets:set NAME`). A plain variable with the same name
# as a secret makes the Cloud Run update fail.
#
# The emulator reads this file as functions/.env and secrets from
# functions/.secret.local.

# --- Access (required) --------------------------------------------------------
# The single Google account allowed to use the API. Set at least one; with
# neither, every authenticated request is refused (503, fail closed).
#   ALLOWED_UID only    -> the UID must match
#   ALLOWED_EMAIL only  -> the verified e-mail must match (no UID needed yet)
#   both                -> both must match
ALLOWED_UID=
ALLOWED_EMAIL=

# --- App Check ----------------------------------------------------------------
# Enforced by default (off in the emulator). "false" disables enforcement.
# ENFORCE_APP_CHECK=false

# --- LLM providers (optional) -------------------------------------------------
# Chat provider order, comma-separated (default: evren,groq,gemini).
# CHAT_FALLBACK_ORDER=groq,gemini
# GROQ_MODEL=openai/gpt-oss-120b
# EVREN_MODEL=qwen3.8-flash-next
# ALFRED_LLM_PROVIDER=groq            # "ollama" switches /health and chat to Ollama
# Self-hosted Ollama reachable from Cloud Run (e.g. a Tailscale Funnel URL).
# No default: unset disables it everywhere (the embedding and memory-extraction
# fallbacks skip it, /health does not probe it, an "ollama" chat turn errors).
# OLLAMA_BASE_URL=https://<your-ollama-host>
# OLLAMA_MODEL=gemma4:12b-mlx

# --- Memory extraction (optional) ---------------------------------------------
# MEMORY_EXTRACTION_MODEL=
# GEMINI_EXTRACTION_MODEL=
