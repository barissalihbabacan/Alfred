{
  "name": "butler-alfred",
  "version": "0.1.0",
  "private": true,
  "description": "B.U.T.L.E.R. Alfred — Barış's Unified Task, Logic, Execution & Reasoning",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:offline": "ALFRED_OFFLINE=1 vitest run tests/integration",
    "test:groq": "tsx scripts/test-groq.ts",
    "test:ollama": "tsx scripts/test-ollama.ts",
    "memory:reindex": "tsx scripts/reindex-memories.ts",
    "backup:firestore": "tsx scripts/backup-firestore.ts",
    "relay": "tsx scripts/home-relay-daemon.ts",
    "generate:user-profile": "node scripts/generate-user-profile-sources.mjs",
    "dev:web": "next dev apps/web -p 3000",
    "build:web": "next build apps/web"
  },
  "keywords": [
    "ai-agent",
    "executive-assistant",
    "butler-alfred"
  ],
  "author": "Barış Babacan",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/ssh2": "^1.15.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.3.0",
    "globals": "^17.12.0",
    "gpt-tokenizer": "^4.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.4",
    "firebase": "^12.19.0",
    "groq-sdk": "^1.6.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0"
  }
}
